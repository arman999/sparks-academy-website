{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sparks-academy-website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },

  // Database where every registration is saved.
  // 1. Run: npx wrangler d1 create sparks-registrations
  // 2. Paste the "database_id" it prints below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sparks-registrations",
      "database_id": "b265611d-a75b-4a3c-bc11-819311b9d04e",
      "migrations_dir": "migrations"
    }
  ],

  // Public settings (not secret). Secrets (RESEND_API_KEY, TURNSTILE_SECRET_KEY)
  // are added with `npx wrangler secret put NAME` or in the Cloudflare dashboard.
  "vars": {
    "NOTIFY_EMAIL": "agoshtas@gmail.com",
    "FROM_EMAIL": "Sparks Academy <registrations@sparksacademyenrichment.com>",
    "SEND_CONFIRMATION": "true"
  }
}
