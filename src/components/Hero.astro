---
import HeroArt from "./HeroArt.astro";
import Icon from "./Icon.astro";
import { hero, site } from "../data/site";

const at = hero.title.indexOf(hero.highlight);
const before = at >= 0 ? hero.title.slice(0, at) : hero.title;
const word = at >= 0 ? hero.highlight : "";
const after = at >= 0 ? hero.title.slice(at + hero.highlight.length) : "";
---

<section class="relative overflow-x-clip pt-4 pb-20 md:pt-8 md:pb-28" data-hero>
      <div class="container-page grid items-center gap-16 lg:grid-cols-[1.25fr_1fr] lg:gap-12">
    <div class="@container">
      <p class="eyebrow">{hero.eyebrow}</p>
            <h1 class="hero-title mt-5 font-extrabold">
        <span class="sr-only">{hero.title}</span>
        <span aria-hidden="true">
          <span class="block whitespace-nowrap">Sparking <span
            class="text-brand inline-block transition-[opacity,translate] duration-300 ease-out"
            data-rotator
            data-words={JSON.stringify(hero.rotatingWords)}
          >{hero.rotatingWords[0]}</span></span>
          <span class="block whitespace-nowrap">in every child’s heart.</span>
        </span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-ink-soft md:text-xl">{hero.subtitle}</p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href={site.joinPath} class="btn btn-join px-8 text-lg" data-hero-cta>
          {hero.primaryCta}
          <Icon name="arrowRight" size={20} />
        </a>
        <a href={hero.secondaryCta.href} class="btn btn-outline px-8 text-lg">{hero.secondaryCta.label}</a>
      </div>

      <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-[0.95rem] font-bold text-ink-soft">
        {hero.facts.map((fact) => (
          <li class="flex items-center gap-2">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-tint text-brand">
              <Icon name={fact.icon} size={16} />
            </span>
            {fact.text}
          </li>
        ))}
      </ul>
    </div>

    <div class="px-6 sm:px-10 lg:px-4">
      <HeroArt />
    </div>
  </div>
</section>
<script>
  // Rotates the highlighted hero word. Visitors with "reduce motion" on see the first word only.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-rotator]").forEach((el) => {
    const words: string[] = JSON.parse(el.dataset.words ?? "[]");
    if (reduceMotion || words.length < 2) return;
    let i = 0;
    setInterval(() => {
      el.classList.add("opacity-0", "-translate-y-2");
      setTimeout(() => {
        i = (i + 1) % words.length;
        el.textContent = words[i];
        el.classList.remove("opacity-0", "-translate-y-2");
      }, 300);
    }, 2200);
  });
</script>