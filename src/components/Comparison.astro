---
/**
 * Two-column comparison. Colors are props, so the same component can be reused
 * with different looks:
 *   <Comparison leftBg="#ffffff" rightBg="var(--color-brand)" />
 * Text comes from src/data/site.ts → `comparison`.
 */
import SparkMark from "./SparkMark.astro";
import Icon from "./Icon.astro";
import { comparison } from "../data/site";

interface Props {
  leftTitle?: string;
  rightTitle?: string;
  rows?: [string, string][];
  leftBg?: string;
  leftText?: string;
  rightBg?: string;
  rightText?: string;
}

const {
  leftTitle = comparison.leftTitle,
  rightTitle = comparison.rightTitle,
  rows = comparison.rows,
  leftBg = "var(--color-mist)",
  leftText = "var(--color-ink-soft)",
  rightBg = "var(--color-brand)",
  rightText = "var(--color-paper)",
} = Astro.props;

const vars = `--cmp-left-bg:${leftBg};--cmp-left-text:${leftText};--cmp-right-bg:${rightBg};--cmp-right-text:${rightText}`;
---

<section id="why-sparks" class="py-20 md:py-28">
  <div class="container-page">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">{comparison.eyebrow}</p>
      <h2 class="mt-4 text-4xl font-extrabold md:text-5xl">{comparison.title}</h2>
    </div>

    <div class="reveal mx-auto mt-12 max-w-5xl overflow-hidden rounded-[2rem] shadow-[0_24px_60px_-30px_rgb(10_9_8/0.35)]" style={vars}>
      <table class="w-full table-fixed border-collapse text-center">
        <thead>
          <tr>
            <th scope="col" class="cmp-left px-3 py-8 align-middle sm:px-8 md:py-10">
              <span class="font-display text-xl leading-tight font-extrabold text-ink sm:text-3xl">{leftTitle}</span>
            </th>
            <th scope="col" class="cmp-right relative overflow-hidden px-3 py-8 align-middle sm:px-8 md:py-10">
              <SparkMark class="absolute top-3 right-3 w-9 sm:top-4 sm:right-5 sm:w-14" color="var(--color-spark)" dotColor="var(--color-paper)" />
              <span class="relative inline-flex items-center gap-2 font-display text-xl leading-tight font-extrabold sm:text-3xl">
                {rightTitle}
              </span>
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map(([left, right]) => (
            <tr>
              <td class="cmp-left border-t border-ink/10 px-3 py-6 align-middle text-[0.95rem] leading-snug sm:px-10 sm:py-8 sm:text-lg">
                <span class="flex flex-col items-center gap-2">
                  <Icon name="x" size={18} class="shrink-0 opacity-50" />
                  {left}
                </span>
              </td>
              <td class="cmp-right border-t border-paper/40 px-3 py-6 align-middle text-[0.95rem] leading-snug font-semibold sm:px-10 sm:py-8 sm:text-lg">
                <span class="flex flex-col items-center gap-2">
                  <Icon name="check" size={20} class="shrink-0 text-action" />
                  {right}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .cmp-left {
    background: var(--cmp-left-bg);
    color: var(--cmp-left-text);
  }
  .cmp-right {
    background: var(--cmp-right-bg);
    color: var(--cmp-right-text);
  }
</style>
