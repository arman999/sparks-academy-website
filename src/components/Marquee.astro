---
/**
 * Infinite scrolling cards. Pauses on hover, on keyboard focus, and with the
 * pause button (required so everyone can stop moving content).
 * Edit the cards in src/data/site.ts → `cards`.
 */
import Icon from "./Icon.astro";
import { cards } from "../data/site";

// The set is rendered twice so the loop is seamless; the copy is hidden from screen readers.
const loop = [...cards, ...cards];
---

<section class="bg-mist py-16 md:py-24" aria-labelledby="cards-title">
  <div class="container-page mb-8 flex items-end justify-between gap-4 md:mb-10">
    <div>
      <p class="eyebrow">Sparks moments</p>
      <h2 id="cards-title" class="mt-3 text-3xl font-extrabold md:text-4xl">What families notice</h2>
    </div>
    <button
      type="button"
      class="flex h-11 shrink-0 items-center gap-2 rounded-full bg-paper px-4 text-sm font-bold text-ink shadow-sm ring-1 ring-line transition-colors hover:bg-line"
      aria-pressed="false"
      data-marquee-toggle
    >
      <span data-icon-pause><Icon name="pause" size={16} /></span>
      <span data-icon-play class="hidden"><Icon name="play" size={16} /></span>
      <span data-label>Pause</span>
    </button>
  </div>

  <div class="marquee group" data-marquee>
    <ul class="marquee-track flex w-max animate-marquee items-stretch gap-[var(--marquee-gap)]" role="list">
      {loop.map((card, i) => {
        const copy = i >= cards.length;
        return card.type === "quote" ? (
          <li class="marquee-card w-[17.5rem] shrink-0 md:w-[22rem]" aria-hidden={copy ? "true" : undefined}>
            <figure class="relative flex h-full flex-col justify-between overflow-hidden rounded-card bg-brand p-7 text-paper">
              <Icon name="quote" size={30} class="text-spark" />
              <blockquote class="mt-4 font-display text-xl leading-snug font-bold md:text-2xl">“{card.text}”</blockquote>
              <figcaption class="mt-6 text-sm font-extrabold tracking-wide text-paper/85">— {card.author}</figcaption>
            </figure>
          </li>
        ) : (
          <li class="marquee-card w-[17.5rem] shrink-0 md:w-[22rem]" aria-hidden={copy ? "true" : undefined}>
            <div class="flex h-full flex-col rounded-card bg-paper p-7 ring-1 ring-line">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-spark-tint text-ink">
                <Icon name={card.icon} size={24} />
              </span>
              <p class="mt-6 font-display text-xl leading-snug font-bold md:text-2xl">{card.text}</p>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<script>
  import "../scripts/marquee.ts";
</script>
