---
import Icon from "./Icon.astro";
import { vision } from "../data/site";
---

<section id="vision" class="py-20 md:py-28">
  <div class="container-page grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
    <div class="reveal lg:sticky lg:top-10 lg:self-start">
      <p class="eyebrow">{vision.eyebrow}</p>
      <h2 class="mt-4 text-4xl font-extrabold md:text-5xl">{vision.title}</h2>
    </div>

    <div class="reveal space-y-8">
      <div class="rounded-card border-l-[6px] border-spark bg-mist p-7 md:p-8">
        <h3 class="text-xl font-extrabold text-brand">Our vision</h3>
        <p class="mt-3 text-lg">{vision.vision}</p>
      </div>
      <div class="rounded-card border-l-[6px] border-action bg-mist p-7 md:p-8">
        <h3 class="text-xl font-extrabold text-brand">Our mission</h3>
        <p class="mt-3 text-lg">{vision.mission}</p>
      </div>
    </div>
  </div>

  <div class="container-page mt-14">
    <h3 class="sr-only">What students explore</h3>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {vision.subjects.map((s) => (
        <li class="reveal flex flex-col items-center gap-3 rounded-card bg-brand-tint px-4 py-6 text-center font-extrabold text-brand">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-paper">
            <Icon name={s.icon} size={24} />
          </span>
          {s.label}
        </li>
      ))}
    </ul>
  </div>
</section>
