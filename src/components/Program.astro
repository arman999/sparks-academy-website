---
import Icon from "./Icon.astro";
import { program, site } from "../data/site";
---

<section id="schedule" class="py-20 md:py-28">
  <div class="container-page">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">{program.eyebrow}</p>
      <h2 class="mt-4 text-4xl font-extrabold md:text-5xl">{program.title}</h2>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-6">
      {/* When */}
      <div class="reveal flex flex-col rounded-[2rem] bg-brand p-8 text-paper md:col-span-3 lg:col-span-2">
        <Icon name="calendar" size={28} class="text-spark" />
        <p class="mt-6 font-display text-5xl font-extrabold">{program.schedule.day}</p>
        <p class="mt-2 text-2xl font-bold">{program.schedule.time}</p>
        <p class="mt-auto pt-6 font-bold text-paper/85">{program.schedule.note}</p>
      </div>

      {/* Character session */}
      <div class="reveal rounded-[2rem] bg-spark-tint p-8 md:col-span-3 lg:col-span-4">
        <div class="flex flex-wrap items-center gap-3">
          <span class="chip bg-spark text-ink">
            <Icon name="clock" size={16} />
            {program.character.time}
          </span>
          <span class="chip bg-paper text-ink">Free · Optional</span>
        </div>
        <h3 class="mt-5 text-2xl font-extrabold md:text-3xl">{program.character.title}</h3>
        <p class="mt-3 text-lg text-ink-soft">{program.character.body}</p>
        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Virtues we explore">
          {program.character.virtues.map((v) => (
            <li class="chip bg-paper text-ink ring-1 ring-ink/10">{v}</li>
          ))}
        </ul>
      </div>

      {/* Tuition */}
      <div class="reveal rounded-[2rem] p-8 ring-1 ring-line md:col-span-4">
        <div class="flex items-center gap-3">
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-brand-tint text-brand">
            <Icon name="tag" size={22} />
          </span>
          <h3 class="text-2xl font-extrabold">Tuition & fees</h3>
        </div>
        <dl class="mt-6 grid gap-4 sm:grid-cols-3">
          {program.tuition.map((t) => (
            <div class="rounded-2xl bg-mist p-5">
              <dt class="text-sm font-extrabold tracking-wide text-ink-soft uppercase">{t.label}</dt>
              <dd class="mt-2">
                <span class="font-display text-4xl font-extrabold text-brand">{t.price}</span>
                <span class="mt-1 block text-sm font-semibold text-ink-soft">{t.unit}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>

      {/* Where */}
      <div class="reveal flex flex-col rounded-[2rem] bg-mist p-8 md:col-span-2">
        <Icon name="mapPin" size={28} class="text-brand" />
        <h3 class="mt-6 text-2xl font-extrabold">{program.location.city}</h3>
        <p class="mt-2 text-ink-soft">{program.location.note}</p>
        <a href={site.phoneHref} class="mt-auto inline-flex items-center gap-2 pt-6 font-extrabold text-brand hover:underline">
          <Icon name="phone" size={18} />
          {site.phone}
        </a>
      </div>
    </div>

    {/* Peanut-free notice */}
    <div class="reveal mt-5 flex items-start gap-4 rounded-2xl border-2 border-dashed border-spark bg-paper p-5 md:items-center md:p-6">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-spark text-ink">
        <Icon name="nutOff" size={22} />
      </span>
      <p class="font-bold">{program.peanutFree}</p>
    </div>
  </div>
</section>
