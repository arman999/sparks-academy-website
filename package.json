{
  "name": "sparks-academy-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && astro preview",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check",
    "db:migrate:local": "wrangler d1 migrations apply sparks-registrations --local",
    "db:migrate:remote": "wrangler d1 migrations apply sparks-registrations --remote",
    "db:list": "wrangler d1 execute sparks-registrations --remote --command \"SELECT created_at, parent_name, email, phone, children_count, children_names FROM registrations ORDER BY created_at DESC LIMIT 50\"",
    "types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^6.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
