---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import SparkMark from "../components/SparkMark.astro";
import { site } from "../data/site";
---

<Layout title="Page not found" noindex>
  <header class="container-page py-5">
    <a href="/" aria-label={`${site.name} home`} class="inline-block rounded-lg"><Logo /></a>
  </header>
  <main id="main" class="container-page py-20 text-center">
    <SparkMark class="mx-auto w-20" color="var(--color-brand)" dotColor="var(--color-spark)" animated />
    <h1 class="mt-8 text-4xl font-extrabold md:text-5xl">This page flew off somewhere.</h1>
    <p class="mx-auto mt-4 max-w-md text-lg text-ink-soft">We couldn’t find what you were looking for, but the good stuff is just a click away.</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/" class="btn btn-outline px-8">Go to the homepage</a>
      <a href={site.joinPath} class="btn btn-join px-8">Join Sparks Today</a>
    </div>
  </main>
</Layout>
